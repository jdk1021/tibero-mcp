# Copy to .env (or set these in your MCP client's env block).

# ── Connection (required) ────────────────────────
TIBERO_HOST=
TIBERO_PORT=8629
# Database name (SID). The JDBC URL becomes jdbc:tibero:thin:@HOST:PORT:DBNAME
TIBERO_DBNAME=
TIBERO_USER=
TIBERO_PASSWORD=

# ── Behaviour (optional) ─────────────────────────
# true: only SELECT/WITH queries and metadata. false: also registers the `execute` tool.
TIBERO_READ_ONLY=true
# Maximum rows returned per call
TIBERO_MAX_ROWS=500
# Statement timeout in seconds (0 = none)
TIBERO_QUERY_TIMEOUT=30

# ── Driver (usually leave empty) ─────────────────
# Empty: the official driver com.tmaxtibero:tbjdbc8 is fetched from Maven Central once and cached.
# Set a path to use a driver jar you already have instead.
TIBERO_JDBC_JAR=
# Empty: the java found on PATH is used.
JAVA_HOME=
